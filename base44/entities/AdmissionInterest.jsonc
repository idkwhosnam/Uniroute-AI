{
  "name": "AdmissionInterest",
  "type": "object",
  "properties": {
    "university_code": {
      "type": "string",
      "description": "M\u00e3 tr\u01b0\u1eddng (tham chi\u1ebfu University.code)"
    },
    "university_name": {
      "type": "string"
    },
    "major_code": {
      "type": "string",
      "description": "M\u00e3 ng\u00e0nh (tham chi\u1ebfu Major.code)"
    },
    "major_name": {
      "type": "string"
    },
    "year": {
      "type": "number",
      "description": "N\u0103m tuy\u1ec3n sinh \u0111ang quan t\u00e2m"
    },
    "method": {
      "type": "string",
      "enum": [
        "thpt",
        "aptitude",
        "cert",
        "combo"
      ],
      "description": "Ph\u01b0\u01a1ng th\u1ee9c x\u00e9t tuy\u1ec3n h\u1ecdc sinh \u0111\u00e1nh d\u1ea5u quan t\u00e2m (\u0111\u1ec3 tr\u1ed1ng n\u1ebfu m\u1edbi ch\u1ec9 quan t\u00e2m ng\u00e0nh - tr\u01b0\u1eddng)"
    },
    "method_label": {
      "type": "string"
    },
    "combination": {
      "type": "string",
      "description": "M\u00e3 t\u1ed5 h\u1ee3p x\u00e9t tuy\u1ec3n, vd A01, D01"
    },
    "combination_subjects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "benchmark_score": {
      "type": "number",
      "description": "\u0110i\u1ec3m chu\u1ea9n t\u1ea1i th\u1eddi \u0111i\u1ec3m quan t\u00e2m"
    },
    "benchmark_scale": {
      "type": "number",
      "default": 30
    },
    "benchmark_year": {
      "type": "number"
    },
    "tuition": {
      "type": "number"
    },
    "quota": {
      "type": "number"
    },
    "conditions": {
      "type": "string",
      "description": "\u0110i\u1ec1u ki\u1ec7n k\u00e8m theo c\u1ee7a ph\u01b0\u01a1ng th\u1ee9c"
    },
    "source_name": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "data_status": {
      "type": "string",
      "enum": [
        "MOCK",
        "UNVERIFIED",
        "VERIFIED"
      ],
      "default": "MOCK"
    },
    "origin": {
      "type": "string",
      "enum": [
        "lookup",
        "orientation",
        "advice"
      ],
      "default": "lookup",
      "description": "Ngu\u1ed3n th\u00eam v\u00e0o: tra c\u1ee9u tuy\u1ec3n sinh, trang \u0111\u1ecbnh h\u01b0\u1edbng hay trang t\u01b0 v\u1ea5n ph\u01b0\u01a1ng th\u1ee9c x\u00e9t tuy\u1ec3n"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "university_code",
    "major_code"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}