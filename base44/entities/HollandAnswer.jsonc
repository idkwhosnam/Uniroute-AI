{
  "name": "HollandAnswer",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "ID phi\u00ean l\u00e0m b\u00e0i, d\u00f9ng \u0111\u1ec3 nh\u00f3m c\u00e2u tr\u1ea3 l\u1eddi"
    },
    "question_code": {
      "type": "string",
      "description": "M\u00e3 c\u00e2u h\u1ecfi (tham chi\u1ebfu HollandQuestion.code)"
    },
    "response": {
      "type": "number",
      "enum": [
        1,
        2,
        3,
        4,
        5
      ],
      "description": "Likert 1-5: 1=R\u1ea5t kh\u00f4ng gi\u1ed1ng, 5=R\u1ea5t gi\u1ed1ng"
    }
  },
  "required": [
    "session_id",
    "question_code",
    "response"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}