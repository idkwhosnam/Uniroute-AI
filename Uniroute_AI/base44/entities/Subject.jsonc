{
  "name": "Subject",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "M\u00e3 m\u00f4n h\u1ecdc, vd toan, van, anh"
    },
    "label": {
      "type": "string",
      "description": "T\u00ean hi\u1ec3n th\u1ecb ti\u1ebfng Vi\u1ec7t"
    },
    "category": {
      "type": "string",
      "enum": [
        "compulsory",
        "elective",
        "cluster"
      ],
      "description": "B\u1eaft bu\u1ed9c / T\u1ef1 ch\u1ecdn / C\u1ee5m chuy\u00ean \u0111\u1ec1 h\u1ecdc t\u1eadp"
    },
    "moet_code": {
      "type": "string",
      "description": "M\u00e3 m\u00f4n theo B\u1ed9 GD&\u0110T (n\u1ebfu c\u00f3)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "key",
    "label",
    "category"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}