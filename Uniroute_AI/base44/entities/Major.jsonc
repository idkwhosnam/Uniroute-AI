{
  "name": "Major",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "M\u00e3 ng\u00e0nh, vd m_httt, m_khmt"
    },
    "name": {
      "type": "string",
      "description": "T\u00ean ng\u00e0nh h\u1ecdc"
    },
    "major_group_code": {
      "type": "string",
      "description": "M\u00e3 nh\u00f3m ng\u00e0nh (tham chi\u1ebfu MajorGroup.code)"
    },
    "riasec_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "R",
          "I",
          "A",
          "S",
          "E",
          "C"
        ]
      },
      "description": "M\u00e3 RIASEC ph\u00f9 h\u1ee3p ng\u00e0nh"
    },
    "description": {
      "type": "string",
      "description": "M\u00f4 t\u1ea3 ng\u00e0nh h\u1ecdc"
    },
    "dev_area": {
      "type": "string",
      "description": "Khu v\u1ef1c ph\u00e1t tri\u1ec3n / l\u01b0u \u00fd"
    },
    "duration_years": {
      "type": "number",
      "default": 4,
      "description": "Th\u1eddi gian \u0111\u00e0o t\u1ea1o (n\u0103m)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "code",
    "name",
    "major_group_code"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}